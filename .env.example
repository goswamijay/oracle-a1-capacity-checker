# ==============================================================================
# Oracle Cloud A1 Flex Capacity Checker - Environment Variables Template
# Copy this file to .env and replace placeholders with your actual OCI values.
# NEVER commit your actual .env file or private keys to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OCI Authentication Credentials (from OCI Console -> User Settings -> API Keys)
# ------------------------------------------------------------------------------
# Tenancy OCID: Profile Icon -> Tenancy: <tenancy_name> -> Copy OCID
OCI_TENANCY=ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# User OCID: Profile Icon -> User Settings -> Copy OCID
OCI_USER=ocid1.user.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Key Fingerprint (displayed when API key is uploaded to OCI Console)
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx

# Region identifier for Mumbai, India West
OCI_REGION=ap-mumbai-1

# Path to private key file (for local / VPS execution)
OCI_KEY_FILE=~/.oci/oci_api_key.pem

# OR provide private key content directly (used in GitHub Actions OCI_PRIVATE_KEY secret)
# OCI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 2. Target Infrastructure Resources
# ------------------------------------------------------------------------------
# Compartment OCID (use root tenancy OCID if instance resides in root compartment)
OCI_COMPARTMENT=ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target Availability Domain (Short 'AD-1' or full tenancy AD string e.g. kONR:AP-MUMBAI-1-AD-1)
OCI_AD=AD-1

# Existing Public Subnet OCID: Networking -> Virtual Cloud Networks -> VCN -> Subnets
OCI_SUBNET=ocid1.subnet.oc1.ap-mumbai-1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Existing Boot Volume OCID: Storage -> Block Storage -> Boot Volumes -> kron-ai
OCI_BOOT_VOLUME=ocid1.bootvolume.oc1.ap-mumbai-1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. Target Instance Specifications (Always Free Limits: up to 4 OCPUs, 24 GB RAM)
# ------------------------------------------------------------------------------
INSTANCE_NAME=kron_new
INSTANCE_SHAPE=VM.Standard.A1.Flex
OCPUS=2
MEMORY_IN_GBS=12
ASSIGN_PUBLIC_IP=true

# ------------------------------------------------------------------------------
# 4. Monitoring & Retry Loop Settings
# ------------------------------------------------------------------------------
RETRY_INTERVAL_SECONDS=60
CHECK_CAPACITY_REPORT_FIRST=true

# ------------------------------------------------------------------------------
# 5. Telegram Notifications (Optional - Leave blank to disable)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
